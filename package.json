{
  "name": "dsh-clean-desktop-shell",
  "version": "0.1.0",
  "description": "Clean frosted-glass desktop shell for DeepSeek Harness (DSH) — Windows/macOS. Reuses your existing web profile, Mica/vibrancy window material. DSH 插件形态的干净毛玻璃桌面壳，复用现有 web profile。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js",
    "dev": "electron electron/main.js",
    "dev:win": "electron electron/main.js --mode=advanced",
    "pack": "electron-builder --win nsis",
    "pack:mac": "electron-builder --mac dmg",
    "pack:win": "electron-builder --win nsis"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.icather.dsh-clean-desktop-shell",
    "productName": "DSH Clean Desktop Shell",
    "asar": true,
    "files": [
      "electron/**/*",
      "lib/**/*",
      "src/**/*",
      "build/icon.png",
      "package.json",
      "cordis.patch.yml"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "license": "MIT",
  "allowScripts": {
    "electron@33.4.11": true
  }
}
